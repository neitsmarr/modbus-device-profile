{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/modbus-device-profile/device-properties.schema.json",
  "title": "Device properties",
  "description": "What a device's properties mean, with no reference to any transport. The Modbus register map is a separate document (device-modbus.schema.json) that references these properties by name. This schema validates structure only; cross-document completeness -- every non-internal property carried by exactly one register field -- is checked by validate.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "device",
    "properties"
  ],
  "properties": {
    "device": {
      "description": "Which device and firmware this profile describes. One profile is one firmware version's register map, as in the company device library.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "firmware_version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "type": {
          "type": "integer",
          "description": "Device series identifier, as reported by the device_type register."
        },
        "firmware_version": {
          "type": "string",
          "pattern": "^(?:0|[1-9]\\d{0,2})\\.(?:0|[1-9]\\d{0,2})(?:\\.(?:0|[1-9]\\d{0,2}))?$"
        },
        "image": {
          "type": "string"
        }
      }
    },
    "procedures": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "additionalProperties": {
        "$ref": "#/$defs/procedure"
      }
    },
    "properties": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "additionalProperties": {
        "$ref": "#/$defs/property"
      },
      "description": "The device's properties, keyed by identifier."
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "maxLength": 48,
      "description": "Also has to be a valid C identifier: the firmware X-macro pastes these into token names."
    },
    "expression": {
      "type": "string",
      "minLength": 1,
      "description": "Boolean expression over signal identifiers and enum member names. The reverse-dependency index is built by collecting signal identifiers out of these, so the grammar must stay small and total (DECISIONS.md D1). The grammar itself is not yet pinned down -- D3, open."
    },
    "enum_member": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
      "maxLength": 48,
      "description": "Enum member name. Uppercase is allowed and often right -- acronyms like LPG read wrong lowercased, and C enum constants are conventionally uppercase. Must still be a valid C identifier for the X-macro. Member names are compared case-sensitively wherever expressions mention them."
    },
    "value": {
      "description": "A register value: an integer, a boolean, an enum member name, or a procedure parameter reference.",
      "oneOf": [
        {
          "type": "integer"
        },
        {
          "type": "boolean"
        },
        {
          "type": "string",
          "pattern": "^\\$param\\.[a-z][a-z0-9_]*$"
        },
        {
          "$ref": "#/$defs/enum_member"
        }
      ]
    },
    "range": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2,
      "description": "[min, max] in engineering units, after scale is applied."
    },
    "enum_map": {
      "type": "object",
      "description": "Raw register value -> member name. Mutually exclusive states.",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^(0|[1-9][0-9]*|0x[0-9a-fA-F]+)$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/enum_member"
      }
    },
    "presentation": {
      "description": "How a raw value becomes an engineering value. Shared by a signal and by each of its variants.",
      "type": "object",
      "properties": {
        "unit": {
          "type": "string"
        },
        "scale": {
          "type": "number",
          "not": {
            "const": 0
          }
        },
        "offset": {
          "type": "number"
        },
        "range": {
          "$ref": "#/$defs/range"
        },
        "step": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "decimals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6,
          "description": "Decimal places to show. Display only -- scale already fixes the value."
        },
        "enum": {
          "$ref": "#/$defs/enum_map"
        },
        "display": {
          "description": "How an int is rendered. 'version' means the raw bytes shown as hex and dot-joined with the leading zero trimmed, so 0x0130 reads as 1.30 -- which is 50 of the 55 bytewise decoders in the company library. Display only: the value is an integer.",
          "enum": [
            "decimal",
            "hex",
            "version"
          ]
        }
      }
    },
    "condition": {
      "type": "object",
      "required": [
        "property"
      ],
      "oneOf": [
        {
          "required": [
            "equals"
          ]
        },
        {
          "required": [
            "in"
          ]
        }
      ],
      "properties": {
        "property": {
          "$ref": "#/$defs/property_ref"
        },
        "equals": {
          "$ref": "#/$defs/value"
        },
        "in": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/value"
          }
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "write"
          ]
        },
        {
          "required": [
            "read"
          ]
        },
        {
          "required": [
            "reread"
          ]
        },
        {
          "required": [
            "await"
          ]
        },
        {
          "required": [
            "delay_ms"
          ]
        }
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "write": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "property",
            "value"
          ],
          "properties": {
            "property": {
              "$ref": "#/$defs/property_ref"
            },
            "value": {
              "$ref": "#/$defs/value"
            }
          }
        },
        "read": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "property"
          ],
          "properties": {
            "property": {
              "$ref": "#/$defs/property_ref"
            }
          }
        },
        "reread": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/property_ref"
          }
        },
        "await": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "timeout_ms"
          ],
          "allOf": [
            {
              "$ref": "#/$defs/condition"
            }
          ],
          "properties": {
            "property": true,
            "equals": true,
            "in": true,
            "timeout_ms": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "poll_ms": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "delay_ms": {
          "type": "number",
          "minimum": 0
        },
        "verify": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "read"
          ],
          "oneOf": [
            {
              "required": [
                "equals"
              ]
            },
            {
              "required": [
                "in"
              ]
            }
          ],
          "properties": {
            "read": {
              "$ref": "#/$defs/property_ref"
            },
            "equals": {
              "$ref": "#/$defs/value"
            },
            "in": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/value"
              }
            },
            "timeout_ms": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        }
      }
    },
    "procedure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "steps"
      ],
      "dependentRequired": {
        "confirm": [
          "danger"
        ]
      },
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "danger": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "description": "Drives how loudly the commissioning tool asks before running."
        },
        "confirm": {
          "type": "string",
          "description": "Shown verbatim before running. Says what breaks, not 'are you sure'."
        },
        "duration_ms": {
          "type": "number",
          "minimum": 0,
          "description": "Expected wall time, for progress UI."
        },
        "preconditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/expression"
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "on_failure": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "outcome": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "success": {
              "$ref": "#/$defs/condition"
            },
            "failure": {
              "$ref": "#/$defs/condition"
            }
          }
        },
        "params": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "oneOf": [
              {
                "required": [
                  "enum_from"
                ]
              },
              {
                "required": [
                  "type"
                ]
              }
            ],
            "properties": {
              "enum_from": {
                "$ref": "#/$defs/property_ref",
                "description": "Take the allowed values from that signal's enum."
              },
              "type": {
                "enum": [
                  "bool",
                  "int",
                  "real",
                  "enum",
                  "text"
                ]
              },
              "range": {
                "$ref": "#/$defs/range"
              },
              "default": {
                "type": [
                  "number",
                  "string",
                  "boolean"
                ]
              },
              "title": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "property": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "kind",
        "type"
      ],
      "allOf": [
        {
          "description": "type and the member map have to agree: an enum needs enum members, a flags value needs flag bits, and nothing else may carry either.",
          "if": {
            "properties": {
              "type": {
                "const": "enum"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "enum"
            ]
          },
          "else": {
            "not": {
              "required": [
                "enum"
              ]
            }
          }
        },
        {
          "description": "labels name a bool's two states, for display and for comparison in expressions. Only a bool has them.",
          "if": {
            "properties": {
              "type": {
                "const": "bool"
              }
            },
            "required": [
              "type"
            ]
          },
          "else": {
            "not": {
              "required": [
                "labels"
              ]
            }
          }
        },
        {
          "description": "scale and decimals describe a continuous quantity; they are meaningless on anything else.",
          "if": {
            "anyOf": [
              {
                "properties": {
                  "type": {
                    "const": "enum"
                  }
                },
                "required": [
                  "type"
                ]
              },
              {
                "properties": {
                  "type": {
                    "const": "bool"
                  }
                },
                "required": [
                  "type"
                ]
              },
              {
                "properties": {
                  "type": {
                    "const": "text"
                  }
                },
                "required": [
                  "type"
                ]
              }
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "scale"
                  ]
                },
                {
                  "required": [
                    "decimals"
                  ]
                }
              ]
            }
          }
        },
        {
          "description": "max_length belongs to text and only to text.",
          "if": {
            "properties": {
              "type": {
                "const": "text"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "max_length"
            ]
          },
          "else": {
            "not": {
              "required": [
                "max_length"
              ]
            }
          }
        },
        {
          "description": "A command is invoked, so it is written and never read back as state.",
          "if": {
            "properties": {
              "kind": {
                "const": "command"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "access": {
                "const": "write_only"
              }
            },
            "required": [
              "access"
            ]
          }
        },
        {
          "description": "A measurement is produced by the device: read-only, and a factory default is meaningless for it.",
          "if": {
            "properties": {
              "kind": {
                "const": "measurement"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "access": {
                "const": "read_only"
              }
            },
            "required": [
              "access"
            ],
            "not": {
              "required": [
                "default"
              ]
            }
          }
        },
        {
          "$ref": "#/$defs/presentation"
        },
        {
          "description": "Presentation comes from exactly one place. If variants are given, the signal must not also carry a top-level interpretation -- otherwise there are two answers and no rule for which wins.",
          "if": {
            "required": [
              "variants"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "unit"
                  ]
                },
                {
                  "required": [
                    "scale"
                  ]
                },
                {
                  "required": [
                    "offset"
                  ]
                },
                {
                  "required": [
                    "range"
                  ]
                },
                {
                  "required": [
                    "enum"
                  ]
                }
              ]
            }
          }
        }
      ],
      "properties": {
        "internal": {
          "description": "True for a property that exists on the device but is carried by no register. Every other property must be mapped by exactly one field of the register map, checked across the two documents by validate.py (D8, D14, D15).",
          "const": true
        },
        "kind": {
          "description": "What sort of thing this is, which is what the generators switch on. 'setting' is persisted in non-volatile memory and has a factory default; 'measurement' is produced by the device and is volatile; 'command' is invoked and stores nothing. Explicit rather than inferred, because an internal property has no table or access pattern to infer it from.",
          "enum": [
            "setting",
            "measurement",
            "command"
          ]
        },
        "type": {
          "description": "What the value IS, independent of how any transport carries it. 'bool' is a truth value; 'int' a whole quantity; 'real' a continuous one; 'enum' one of named members; 'text' a character string. A set of independent bits is NOT a type: each bit is its own bool property bound to a bit of a register (D11). This is the type firmware should declare -- bool as bool, enum as an enum typedef -- and it is deliberately NOT the register width: a real may travel as float32 over two registers or as a scaled int16 over one, and a bool as a coil, a discrete input or a bit in a register.",
          "enum": [
            "bool",
            "int",
            "real",
            "enum",
            "text"
          ]
        },
        "storage": {
          "description": "Width used when the value is persisted or held in a live-data struct. Omit it and the width is derived from range (and scale, for a real), which is the normal case; declare it only when the device stores the value wider than the range needs, or when there is no range to derive from. Checked against the range either way.",
          "enum": [
            "bool",
            "uint8",
            "int8",
            "uint16",
            "int16",
            "uint32",
            "int32",
            "uint64",
            "int64",
            "float32",
            "float64"
          ]
        },
        "max_length": {
          "description": "Maximum character count, for type 'text' only.",
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "access": {
          "description": "Access rights, following the company device library. Absent means read_write.",
          "enum": [
            "read_only",
            "write_only",
            "read_write"
          ],
          "default": "read_write"
        },
        "hidden": {
          "type": "boolean",
          "default": false,
          "description": "Service register: real, documented here, not shown to an ordinary user."
        },
        "default": {
          "description": "Factory default, in engineering units or as an enum member. Where the default depends on configuration, put it in constraints instead.",
          "type": [
            "number",
            "string",
            "boolean"
          ]
        },
        "unit": true,
        "scale": true,
        "offset": true,
        "range": true,
        "step": true,
        "decimals": true,
        "enum": true,
        "display": true,
        "labels": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "false",
            "true"
          ],
          "description": "Names for a bool's two states, e.g. { false: disabled, true: enabled }. What documentation and a commissioning tool show, and what an expression may compare against.",
          "properties": {
            "false": {
              "$ref": "#/$defs/enum_member"
            },
            "true": {
              "$ref": "#/$defs/enum_member"
            }
          }
        },
        "present_when": {
          "$ref": "#/$defs/expression"
        },
        "valid_when": {
          "$ref": "#/$defs/expression"
        },
        "writable_when": {
          "$ref": "#/$defs/expression"
        },
        "variants": {
          "type": "array",
          "minItems": 2,
          "description": "Alternative interpretations of the same register, one per configuration. A single variant is a modelling mistake: use top-level presentation instead.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "effective_when"
            ],
            "allOf": [
              {
                "$ref": "#/$defs/presentation"
              }
            ],
            "properties": {
              "effective_when": {
                "$ref": "#/$defs/expression"
              },
              "unit": true,
              "scale": true,
              "offset": true,
              "range": true,
              "step": true,
              "decimals": true,
              "enum": true,
              "display": true
            }
          }
        },
        "constraints": {
          "type": "array",
          "minItems": 1,
          "description": "Range/default/step that depend on configuration. First matching entry wins.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "when"
            ],
            "anyOf": [
              {
                "required": [
                  "range"
                ]
              },
              {
                "required": [
                  "default"
                ]
              },
              {
                "required": [
                  "step"
                ]
              }
            ],
            "properties": {
              "when": {
                "$ref": "#/$defs/expression"
              },
              "range": {
                "$ref": "#/$defs/range"
              },
              "default": {
                "type": [
                  "number",
                  "string",
                  "boolean"
                ]
              },
              "step": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        },
        "on_write": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "reread": {
              "description": "What to re-read after writing this signal. The literal 'dependents' resolves against the derived reverse index; an explicit list covers registers the device re-clamps without any expression saying so.",
              "oneOf": [
                {
                  "const": "dependents"
                },
                {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "$ref": "#/$defs/property_ref"
                  }
                }
              ]
            },
            "settle_ms": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    },
    "property_ref": {
      "$ref": "#/$defs/identifier"
    }
  }
}
